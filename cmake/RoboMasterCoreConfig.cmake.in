@PACKAGE_INIT@

find_path(CANBRIDGE_INCLUDE_DIR NAMES CANBridge.h)
if(NOT CANBRIDGE_INCLUDE_DIR)
    set(RoboMasterCore_FOUND FALSE)
    set(RoboMasterCore_NOT_FOUND_MESSAGE
        "CANBridge.h was not found. Install CANBridge before using RoboMasterCore.")
    return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/RoboMasterCoreTargets.cmake")
set_property(TARGET RoboMaster::Core APPEND PROPERTY
    INTERFACE_INCLUDE_DIRECTORIES "${CANBRIDGE_INCLUDE_DIR}")

check_required_components(RoboMasterCore)
